---
const keywords = [
  "Public Relations",
  "Artist Communications",
  "Media Relations",
  "Creative Strategy",
  "Brand Communication",
];
---

<section class="intro section tex-dots" id="intro" aria-labelledby="intro-title">
  <div class="shell intro__grid">
    <span class="label reveal reveal--fade" id="intro-title">Through Her DevCom Lens</span>

    <div class="intro__body stack-md reveal" style="--reveal-delay: 0.1s">
      <p class="lede">
        Hairly Baylen, through the lens of Development Communication, crafts
        intentional messages that go beyond information — turning ideas into
        action. By blending strategic communication, storytelling, and
        community-focused insight, her work seeks to inform, engage, and
        catalyze meaningful social change.
      </p>

      <ul class="intro__keywords" aria-label="Focus areas">
        {
          keywords.map((word) => (
            <li>{word}</li>
          ))
        }
      </ul>
    </div>
  </div>
</section>

<style>
  .intro__grid {
    display: grid;
    grid-template-columns: minmax(10rem, 1fr) 3fr;
    gap: clamp(1.5rem, 5vw, 4rem);
    align-items: start;
  }

  .intro__keywords {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    padding-top: 0.5rem;
  }

  .intro__keywords li {
    font-size: 0.78rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink-soft);
    border: 1px solid var(--line);
    border-radius: 999px;
    padding: 0.5em 1.1em;
  }

  @media (max-width: 720px) {
    .intro__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
