---
import { queue } from "../data/queue";
---

<section class="section queue tex-dark-glow" id="queue" aria-labelledby="queue-title">
  <div class="shell">
    <header class="section-head">
      <div class="stack-sm reveal">
        <span class="label">Currently</span>
        <h2 class="section-title" id="queue-title">The Queue</h2>
      </div>
      <p class="body-text queue__note">
        What's on the desk right now — projects, artists, and campaigns in
        motion.
      </p>
    </header>

    <ul class="queue__list">
      {
        queue.map((item, i) => (
          <li
            class="queue__item reveal"
            style={`--reveal-delay: ${i * 0.08}s`}
          >
            <span class="queue__number">{item.number}</span>
            <div class="queue__main">
              <div class="queue__head">
                <span class="queue__type">{item.type}</span>
                <span class="queue__status" data-status={item.status}>
                  {item.status}
                </span>
              </div>
              <h3 class="queue__title">{item.title}</h3>
              <p class="body-text">{item.description}</p>
            </div>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .queue {
    background-color: var(--ink);
    border-top: 0;
  }

  .queue .label,
  .queue .section-title,
  .queue .queue__note {
    color: inherit;
  }

  .queue .label {
    color: color-mix(in srgb, var(--paper) 55%, transparent);
  }

  .queue .queue__note {
    color: color-mix(in srgb, var(--paper) 70%, transparent);
    max-width: 30ch;
    text-align: right;
  }

  .queue__list {
    border-top: 1px solid color-mix(in srgb, var(--paper) 25%, transparent);
  }

  .queue__item {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: clamp(1.25rem, 4vw, 3rem);
    align-items: start;
    padding-block: clamp(1.75rem, 4vw, 2.5rem);
    border-bottom: 1px solid color-mix(in srgb, var(--paper) 20%, transparent);
    transition: background 0.25s ease;
  }

  .queue__number {
    font-family: var(--font-display);
    font-size: clamp(2.5rem, 6vw, 4rem);
    line-height: 0.9;
    color: color-mix(in srgb, var(--paper) 40%, transparent);
    min-width: 2.2ch;
  }

  .queue__head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1.25rem;
    margin-bottom: 0.6rem;
  }

  .queue__type {
    font-size: 0.74rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: color-mix(in srgb, var(--paper) 55%, transparent);
  }

  .queue__status {
    font-size: 0.68rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    border: 1px solid color-mix(in srgb, var(--paper) 35%, transparent);
    border-radius: 999px;
    padding: 0.3em 0.9em;
    color: color-mix(in srgb, var(--paper) 80%, transparent);
  }

  .queue__status[data-status="In Motion"],
  .queue__status[data-status="In Progress"] {
    border-color: var(--accent);
    color: #e8a48a;
  }

  .queue__title {
    font-size: clamp(1.6rem, 3.5vw, 2.5rem);
    margin-bottom: 0.5rem;
  }

  .queue .body-text {
    color: color-mix(in srgb, var(--paper) 65%, transparent);
    max-width: 58ch;
  }

  @media (max-width: 760px) {
    .queue .queue__note {
      text-align: left;
    }
  }
</style>
