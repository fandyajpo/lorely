---
import {
  eventsIntro,
  eventTypes,
  eventPhases,
  opportunityFlow,
  opportunityQuestion,
} from "../data/events";
---

<section class="section events tex-rules" id="events" aria-labelledby="service-5-title">
  <div class="shell">
    <header class="case__header reveal">
      <span class="case__number" data-parallax="0.5" aria-hidden="true">05</span>
      <div class="stack-sm">
        <span class="label">Service</span>
        <h2 class="case__title" id="service-5-title">
          Events &amp; External Relations
        </h2>
      </div>
    </header>

    <p class="lede events__intro reveal" style="--reveal-delay: 0.08s">{eventsIntro}</p>

    <ul class="events__types">
      {
        eventTypes.map((item, i) => (
          <li
            class="events__type reveal"
            style={`--reveal-delay: ${i * 0.05}s`}
          >
            <h3 class="events__type-name">{item.name}</h3>
            <p class="body-text">{item.description}</p>
          </li>
        ))
      }
    </ul>

    <div class="phases" aria-label="Event communication phases">
      {
        eventPhases.map((phase, i) => (
          <div
            class="phases__col reveal"
            style={`--reveal-delay: ${i * 0.1}s`}
          >
            <span class="phases__label">{phase.label}</span>
            <ol class="phases__list">
              {phase.items.map((item) => (
                <li>{item}</li>
              ))}
            </ol>
          </div>
        ))
      }
    </div>

    <div class="opportunity reveal" style="--reveal-delay: 0.1s">
      <span class="label">My PR Opportunity</span>
      <p class="opportunity__q italic">{opportunityQuestion}</p>
      <ol class="opportunity__flow" aria-label="Event to audience connection">
        {
          opportunityFlow.map((step, i) => (
            <li class="opportunity__step">
              <span>{step}</span>
              {i < opportunityFlow.length - 1 && (
                <span class="opportunity__arrow" aria-hidden="true">
                  →
                </span>
              )}
            </li>
          ))
        }
      </ol>
      <p class="body-text opportunity__note">
        Much more PR-oriented than simply describing the event — the event is
        the raw material; the story is the product.
      </p>
    </div>
  </div>
</section>

<style>
  .case__header {
    display: flex;
    align-items: baseline;
    gap: clamp(1rem, 3vw, 2rem);
    padding-bottom: clamp(1.5rem, 3vw, 2rem);
    border-bottom: 1px solid var(--line);
    margin-bottom: clamp(2rem, 5vw, 3.5rem);
  }

  .case__number {
    font-family: var(--font-display);
    font-size: clamp(3rem, 8vw, 5.5rem);
    line-height: 0.85;
    color: var(--accent);
  }

  .case__title {
    font-size: var(--step-h2);
    max-width: 16ch;
  }

  .events__intro {
    max-width: 62ch;
    margin-bottom: clamp(2.5rem, 6vw, 4rem);
  }

  .events__types {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: clamp(1.5rem, 3vw, 2.5rem);
    padding-top: clamp(1.5rem, 3vw, 2rem);
    border-top: 1px solid var(--ink);
    margin-bottom: clamp(3rem, 7vw, 5rem);
  }

  .events__type-name {
    font-family: var(--font-display);
    font-size: clamp(1.2rem, 2vw, 1.5rem);
    margin-bottom: 0.5rem;
  }

  .events__type .body-text {
    font-size: 0.93rem;
  }

  /* phases */
  .phases {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: clamp(1.25rem, 3vw, 2rem);
    margin-bottom: clamp(3rem, 7vw, 5rem);
  }

  .phases__col {
    background: var(--paper-deep);
    border: 1px solid var(--line);
    padding: clamp(1.25rem, 3vw, 2rem);
  }

  .phases__label {
    display: block;
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 3vw, 2rem);
    text-transform: uppercase;
    padding-bottom: 1rem;
    margin-bottom: 1rem;
    border-bottom: 1px solid var(--ink);
  }

  .phases__list li {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
    padding-block: 0.65rem;
    color: var(--ink-soft);
    font-size: 0.97rem;
  }

  .phases__list li:not(:last-child)::after {
    content: "→";
    order: 2;
    color: var(--accent);
    font-size: 0.8rem;
  }

  /* opportunity */
  .opportunity {
    border-top: 1px solid var(--ink);
    padding-top: clamp(2rem, 5vw, 3rem);
  }

  .opportunity__q {
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 3.5vw, 2.5rem);
    margin-top: 0.75rem;
    max-width: 24ch;
  }

  .opportunity__flow {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1.25rem;
    margin-top: clamp(1.5rem, 4vw, 2.5rem);
    padding: 1.25rem 0;
    border-top: 1px dashed var(--line);
    border-bottom: 1px dashed var(--line);
  }

  .opportunity__step {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    font-family: var(--font-display);
    font-size: clamp(1.2rem, 2.5vw, 1.7rem);
    text-transform: uppercase;
  }

  .opportunity__arrow {
    color: var(--accent);
    font-family: var(--font-sans);
  }

  .opportunity__note {
    margin-top: 1.5rem;
    max-width: 52ch;
  }

  @media (max-width: 1000px) {
    .events__types {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (max-width: 760px) {
    .phases {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 560px) {
    .events__types {
      grid-template-columns: 1fr;
    }
  }
</style>
