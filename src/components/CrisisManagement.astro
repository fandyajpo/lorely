---
import {
  crisisIntro,
  crisisScenario,
  crisisSteps,
  holdingStatement,
  artistGuidance,
} from "../data/crisis";
---

<section class="section crisis tex-dark-dots" id="crisis" aria-labelledby="service-6-title">
  <div class="shell">
    <header class="case__header reveal">
      <span class="case__number" data-parallax="0.5" aria-hidden="true">06</span>
      <div class="stack-sm">
        <span class="label">Service</span>
        <h2 class="case__title" id="service-6-title">
          Crisis &amp; Reputation Management
        </h2>
      </div>
    </header>

    <div class="crisis__top reveal" style="--reveal-delay: 0.08s">
      <p class="lede">{crisisIntro}</p>
      <div class="crisis__scenario">
        <span class="label">Scenario</span>
        <p class="crisis__scenario-text">{crisisScenario}</p>
      </div>
    </div>

    <ol class="crisis__flow">
      {
        crisisSteps.map((step, i) => (
          <li
            class="crisis__step reveal"
            style={`--reveal-delay: ${i * 0.07}s`}
          >
            <span class="crisis__label">{step.label}</span>
            {step.text && <p class="crisis__text">{step.text}</p>}
            {step.points && (
              <ul class="crisis__points">
                {step.points.map((p) => (
                  <li>{p}</li>
                ))}
              </ul>
            )}
          </li>
        ))
      }
    </ol>

    <div class="crisis__panels">
      <div class="panel panel--statement reveal">
        <span class="label">Holding statement</span>
        <blockquote>{holdingStatement}</blockquote>
        <p class="panel__note">
          A short, factual first word — what is known, what is being verified,
          and when more will follow.
        </p>
      </div>

      <div class="panel reveal" style="--reveal-delay: 0.1s">
        <span class="label">Artist guidance</span>
        <div class="guidance">
          <div>
            <h3 class="guidance__head guidance__head--do">Do</h3>
            <ul>
              {
                artistGuidance.do.map((item) => (
                  <li>{item}</li>
                ))
              }
            </ul>
          </div>
          <div>
            <h3 class="guidance__head guidance__head--dont">Don't</h3>
            <ul>
              {
                artistGuidance.dont.map((item) => (
                  <li>{item}</li>
                ))
              }
            </ul>
          </div>
        </div>
      </div>

      <div class="panel panel--recovery reveal" style="--reveal-delay: 0.2s">
        <span class="label">Reputation recovery</span>
        <p class="body-text">
          After the immediate crisis: reflect internally, correct the narrative
          gradually through consistent action, and rebuild attention with work
          rather than words.
        </p>
        <p class="recovery-chain" aria-label="Crisis PR sequence">
          <span class="chain-word">Protect the artist</span>
          <span class="chain-arrow" aria-hidden="true">→</span>
          <span class="chain-word">protect credibility</span>
          <span class="chain-arrow" aria-hidden="true">→</span>
          <span class="chain-word">maintain trust</span>
          <span class="chain-arrow" aria-hidden="true">→</span>
          <span class="chain-word">recover reputation</span>
        </p>
      </div>
    </div>
  </div>
</section>

<style>
  .crisis {
    background-color: var(--ink);
    color: var(--paper);
    border-top: 0;
  }

  .crisis .label {
    color: color-mix(in srgb, var(--paper) 55%, transparent);
  }

  .crisis .lede,
  .crisis .body-text {
    color: color-mix(in srgb, var(--paper) 75%, transparent);
  }

  .case__header {
    display: flex;
    align-items: baseline;
    gap: clamp(1rem, 3vw, 2rem);
    padding-bottom: clamp(1.5rem, 3vw, 2rem);
    border-bottom: 1px solid color-mix(in srgb, var(--paper) 25%, transparent);
    margin-bottom: clamp(2rem, 5vw, 3.5rem);
  }

  .case__number {
    font-family: var(--font-display);
    font-size: clamp(3rem, 8vw, 5.5rem);
    line-height: 0.85;
    color: var(--accent);
  }

  .case__title {
    font-size: var(--step-h2);
    max-width: 16ch;
    color: var(--paper);
  }

  .crisis__top {
    display: grid;
    grid-template-columns: 1.4fr 1fr;
    gap: clamp(2rem, 5vw, 4rem);
    align-items: start;
    margin-bottom: clamp(2.5rem, 6vw, 4rem);
  }

  .crisis__scenario {
    border: 1px solid color-mix(in srgb, var(--paper) 30%, transparent);
    padding: clamp(1.25rem, 3vw, 1.75rem);
  }

  .crisis__scenario-text {
    font-family: var(--font-display);
    font-size: clamp(1.2rem, 2.4vw, 1.55rem);
    line-height: 1.35;
    margin-top: 0.75rem;
  }

  .crisis__flow {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1px;
    background: color-mix(in srgb, var(--paper) 25%, transparent);
    border: 1px solid color-mix(in srgb, var(--paper) 25%, transparent);
    margin-bottom: clamp(2.5rem, 6vw, 4rem);
  }

  .crisis__step {
    background: var(--ink);
    padding: clamp(1.25rem, 3vw, 1.75rem);
    position: relative;
  }

  .crisis__step:not(:last-child)::after {
    content: "→";
    position: absolute;
    right: -0.65rem;
    top: 50%;
    transform: translateY(-50%);
    color: var(--accent);
    z-index: 1;
    background: var(--ink);
    padding: 0.2rem;
    font-size: 0.9rem;
  }

  .crisis__label {
    display: block;
    font-size: 0.7rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--accent-soft);
    font-weight: 500;
    margin-bottom: 0.7rem;
  }

  .crisis__text {
    font-family: var(--font-display);
    font-size: clamp(1.05rem, 2vw, 1.25rem);
    line-height: 1.4;
    color: var(--paper);
  }

  .crisis__points {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-top: 0.75rem;
  }

  .crisis__points li {
    font-size: 0.76rem;
    border: 1px solid color-mix(in srgb, var(--paper) 30%, transparent);
    border-radius: 999px;
    padding: 0.3em 0.85em;
    color: color-mix(in srgb, var(--paper) 80%, transparent);
  }

  .crisis__panels {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: clamp(1.25rem, 3vw, 2rem);
  }

  .panel {
    border: 1px solid color-mix(in srgb, var(--paper) 25%, transparent);
    padding: clamp(1.25rem, 3vw, 2rem);
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .panel blockquote {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(1.1rem, 2vw, 1.3rem);
    line-height: 1.45;
    font-style: italic;
    color: color-mix(in srgb, var(--paper) 90%, transparent);
  }

  .panel__note {
    font-size: 0.9rem;
    color: color-mix(in srgb, var(--paper) 60%, transparent);
    margin-top: auto;
  }

  .guidance {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .guidance__head {
    font-family: var(--font-sans);
    font-size: 0.74rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    font-weight: 500;
    margin-bottom: 0.6rem;
  }

  .guidance__head--do {
    color: #9fc7a3;
  }

  .guidance__head--dont {
    color: var(--accent-soft);
  }

  .guidance li {
    position: relative;
    padding: 0.45rem 0 0.45rem 1.2rem;
    font-size: 0.93rem;
    color: color-mix(in srgb, var(--paper) 75%, transparent);
    border-bottom: 1px solid color-mix(in srgb, var(--paper) 15%, transparent);
  }

  .guidance li::before {
    content: "·";
    position: absolute;
    left: 0.3rem;
    color: var(--accent);
  }

  .recovery-chain {
    font-family: var(--font-display);
    font-size: clamp(1.1rem, 2vw, 1.3rem);
    line-height: 1.5;
    color: var(--paper);
    padding-top: 1rem;
    border-top: 1px solid color-mix(in srgb, var(--paper) 20%, transparent);
    margin-top: auto;
  }

  .recovery-chain span {
    color: var(--accent);
    margin-inline: 0.3rem;
  }

  /* scroll-lit sequence */
  :global(.has-js) .chain-word {
    color: color-mix(in srgb, var(--paper) 90%, transparent);
    opacity: 0.22;
    transition: opacity 0.45s ease;
  }

  :global(.has-js) .chain-word.is-lit {
    opacity: 1;
  }

  @media (max-width: 1000px) {
    .crisis__flow {
      grid-template-columns: 1fr 1fr;
    }

    .crisis__step:nth-child(2)::after {
      display: none;
    }

    .crisis__panels {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 760px) {
    .crisis__top {
      grid-template-columns: 1fr;
    }

    .crisis__flow {
      grid-template-columns: 1fr;
    }

    .crisis__step::after {
      display: none;
    }
  }
</style>
