---
const links = [
  { href: "#about", label: "About" },
  { href: "#experience", label: "Experience" },
  { href: "#work", label: "Work" },
  { href: "#contact", label: "Contact" },
];
---

<header class="nav">
  <div class="nav__inner shell">
    <a class="nav__logo" href="#top">Hairly</a>

    <nav class="nav__links" aria-label="Primary">
      {
        links.map((link) => (
          <a href={link.href}>{link.label}</a>
        ))
      }
    </nav>

    <details class="nav__menu">
      <summary aria-label="Open menu">
        <span class="nav__menu-bars" aria-hidden="true"></span>
        Menu
      </summary>
      <nav class="nav__drawer" aria-label="Mobile">
        {
          links.map((link) => (
            <a href={link.href}>{link.label}</a>
          ))
        }
      </nav>
    </details>
  </div>
</header>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 50;
    background: color-mix(in srgb, var(--paper) 88%, transparent);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--line);
  }

  .nav__inner {
    height: var(--nav-h);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
  }

  .nav__logo {
    font-family: var(--font-display);
    font-size: 1.5rem;
    text-decoration: none;
    letter-spacing: -0.01em;
  }

  .nav__links {
    display: flex;
    gap: clamp(1.25rem, 3vw, 2.5rem);
  }

  .nav__links a {
    font-size: 0.78rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--ink-soft);
    transition: color 0.2s ease;
  }

  .nav__links a:hover {
    color: var(--accent);
  }

  .nav__menu {
    display: none;
    position: relative;
  }

  .nav__menu summary {
    list-style: none;
    cursor: pointer;
    font-size: 0.78rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    user-select: none;
  }

  .nav__menu summary::-webkit-details-marker {
    display: none;
  }

  .nav__menu-bars,
  .nav__menu-bars::before,
  .nav__menu-bars::after {
    display: block;
    width: 18px;
    height: 1.5px;
    background: var(--ink);
    content: "";
  }

  .nav__menu-bars::before {
    transform: translateY(-5px);
  }

  .nav__menu-bars::after {
    transform: translateY(3.5px);
  }

  .nav__drawer {
    position: absolute;
    right: 0;
    top: calc(100% + 1.1rem);
    min-width: 12rem;
    background: var(--paper);
    border: 1px solid var(--line);
    display: flex;
    flex-direction: column;
    padding: 0.5rem 0;
  }

  .nav__drawer a {
    padding: 0.85rem 1.25rem;
    text-decoration: none;
    font-size: 0.8rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--ink-soft);
  }

  .nav__drawer a:hover {
    color: var(--accent);
    background: var(--paper-deep);
  }

  @media (max-width: 720px) {
    .nav__links {
      display: none;
    }

    .nav__menu {
      display: block;
    }
  }
</style>
