---
import { practiceIntro, practiceItems } from "../data/practice";
---

<section class="section practice tex-grid-lg" aria-labelledby="service-7-title">
  <div class="shell">
    <header class="case__header reveal">
      <span class="case__number" aria-hidden="true">07</span>
      <div class="stack-sm">
        <span class="label">Practice</span>
        <h2 class="case__title" id="service-7-title">
          Audience Research, Measurement, Ethics &amp; Professional Development
        </h2>
      </div>
    </header>

    <p class="lede practice__intro reveal" style="--reveal-delay: 0.08s">{practiceIntro}</p>

    <ul class="practice__list">
      {
        practiceItems.map((item, i) => (
          <li
            class="practice__item reveal"
            style={`--reveal-delay: ${i * 0.06}s`}
          >
            <div class="practice__item-head">
              <h3 class="practice__name">{item.name}</h3>
            </div>
            <p class="body-text">{item.description}</p>
          </li>
        ))
      }
    </ul>

    <div class="practice__cta reveal" style="--reveal-delay: 0.15s">
      <a class="btn btn--solid" href="#contact">Let's Work Together</a>
    </div>
  </div>
</section>

<style>
  .case__header {
    display: flex;
    align-items: baseline;
    gap: clamp(1rem, 3vw, 2rem);
    padding-bottom: clamp(1.5rem, 3vw, 2rem);
    border-bottom: 1px solid var(--line);
    margin-bottom: clamp(2rem, 5vw, 3.5rem);
  }

  .case__number {
    font-family: var(--font-display);
    font-size: clamp(3rem, 8vw, 5.5rem);
    line-height: 0.85;
    color: var(--accent);
  }

  .case__title {
    font-size: clamp(1.75rem, 4vw, 3rem);
    max-width: 24ch;
  }

  .practice__intro {
    max-width: 58ch;
    margin-bottom: clamp(2.5rem, 6vw, 4rem);
  }

  .practice__list {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: clamp(1.5rem, 3vw, 2.5rem);
    padding-top: clamp(1.5rem, 3vw, 2rem);
    border-top: 1px solid var(--ink);
  }

  .practice__item {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid var(--line);
  }

  .practice__name {
    font-family: var(--font-display);
    font-size: clamp(1.2rem, 2.2vw, 1.5rem);
    line-height: 1.2;
  }

  .practice__cta {
    display: flex;
    justify-content: center;
    margin-top: clamp(3rem, 7vw, 5rem);
  }

  @media (max-width: 900px) {
    .practice__list {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (max-width: 560px) {
    .practice__list {
      grid-template-columns: 1fr;
    }
  }
</style>
