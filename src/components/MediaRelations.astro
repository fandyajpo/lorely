---
import {
  mediaIntro,
  mediaSubServices,
  mediaProcess,
  pitchSample,
} from "../data/media";
---

<section class="section media tex-grid" id="media" aria-labelledby="service-2-title">
  <div class="shell">
    <header class="case__header reveal">
      <span class="case__number" data-parallax="0.5" aria-hidden="true">02</span>
      <div class="stack-sm">
        <span class="label">Service</span>
        <h2 class="case__title" id="service-2-title" data-split>
          Media Relations
        </h2>
      </div>
    </header>

    <p class="lede media__intro reveal" style="--reveal-delay: 0.08s">{mediaIntro}</p>

    <div class="media__grid">
      <ul class="media__subs">
        {
          mediaSubServices.map((item, i) => (
            <li class="reveal" style={`--reveal-delay: ${i * 0.05}s`}>
              <h3 class="media__sub-name">{item.name}</h3>
              <p class="body-text">{item.description}</p>
            </li>
          ))
        }
      </ul>

      <div class="media__process reveal reveal--right" style="--reveal-delay: 0.15s">
        <span class="label">Process — Artist comeback → media coverage</span>
        <ol class="steps">
          {
            mediaProcess.map((step) => (
              <li class="steps__item">
                <span class="steps__num">{step.number}</span>
                <div>
                  <span class="steps__title">{step.title}</span>
                  <p class="steps__text">{step.text}</p>
                </div>
              </li>
            ))
          }
        </ol>
      </div>
    </div>

    <div class="pitch reveal" style="--reveal-delay: 0.1s">
      <div class="pitch__head">
        <span class="label">Sample — {pitchSample.context}</span>
        <p class="pitch__subject">{pitchSample.subject}</p>
      </div>
      <div class="pitch__reasons">
        {
          pitchSample.reasons.map((r) => (
            <div class="pitch__reason">
              <span class="pitch__label">{r.label}</span>
              <p class="body-text">{r.text}</p>
            </div>
          ))
        }
      </div>
      <blockquote class="pitch__quote">“{pitchSample.quote}”</blockquote>
    </div>
  </div>
</section>

<style>
  .case__header {
    display: flex;
    align-items: baseline;
    gap: clamp(1rem, 3vw, 2rem);
    padding-bottom: clamp(1.5rem, 3vw, 2rem);
    border-bottom: 1px solid var(--line);
    margin-bottom: clamp(2rem, 5vw, 3.5rem);
  }

  .case__number {
    font-family: var(--font-display);
    font-size: clamp(3rem, 8vw, 5.5rem);
    line-height: 0.85;
    color: var(--accent);
  }

  .case__title {
    font-size: var(--step-h2);
    max-width: 16ch;
  }

  .media__intro {
    max-width: 62ch;
    margin-bottom: clamp(2.5rem, 6vw, 4rem);
  }

  .media__grid {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    gap: clamp(2rem, 6vw, 5rem);
    align-items: start;
  }

  .media__subs li {
    padding-block: 1.25rem;
    border-bottom: 1px solid var(--line);
  }

  .media__subs li:first-child {
    border-top: 1px solid var(--line);
  }

  .media__sub-name {
    font-family: var(--font-display);
    font-size: clamp(1.25rem, 2.5vw, 1.6rem);
    margin-bottom: 0.4rem;
  }

  .media__process {
    position: sticky;
    top: calc(var(--nav-h) + 1.5rem);
    background: var(--paper-deep);
    border: 1px solid var(--line);
    padding: clamp(1.25rem, 3vw, 2rem);
  }

  .steps {
    margin-top: 1.25rem;
  }

  .steps__item {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 1rem;
    padding-block: 0.9rem;
    border-bottom: 1px dashed var(--line);
  }

  .steps__item:last-child {
    border-bottom: 0;
    padding-bottom: 0;
  }

  .steps__num {
    font-family: var(--font-display);
    font-size: 1.35rem;
    color: var(--accent);
    min-width: 2ch;
  }

  .steps__title {
    display: block;
    font-size: 0.74rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    font-weight: 500;
  }

  .steps__text {
    color: var(--ink-soft);
    font-size: 0.95rem;
    margin-top: 0.25rem;
  }

  /* pitch */
  .pitch {
    margin-top: clamp(3rem, 7vw, 5rem);
    border: 1px solid var(--ink);
    background: var(--paper);
    padding: clamp(1.5rem, 4vw, 3rem);
  }

  .pitch__subject {
    font-family: var(--font-display);
    font-size: clamp(1.35rem, 3vw, 2rem);
    line-height: 1.3;
    margin-top: 1rem;
    max-width: 36ch;
  }

  .pitch__head {
    padding-bottom: clamp(1.25rem, 3vw, 2rem);
    border-bottom: 1px solid var(--line);
  }

  .pitch__reasons {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: clamp(1.25rem, 3vw, 2.5rem);
    padding-block: clamp(1.5rem, 3vw, 2rem);
  }

  .pitch__label {
    display: block;
    font-size: 0.72rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--accent);
    font-weight: 500;
    margin-bottom: 0.6rem;
  }

  .pitch__quote {
    margin: 0;
    padding-top: clamp(1.25rem, 3vw, 2rem);
    border-top: 1px solid var(--line);
    font-family: var(--font-display);
    font-style: italic;
    font-size: clamp(1.2rem, 2.5vw, 1.6rem);
    color: var(--ink-soft);
    max-width: 48ch;
  }

  @media (max-width: 900px) {
    .media__grid,
    .pitch__reasons {
      grid-template-columns: 1fr;
    }

    .media__process {
      position: static;
    }
  }
</style>
