---
const education = {
  school: "Camarines Sur Polytechnic Colleges",
  location: "Nabua, Camarines Sur, Philippines",
  degree: "Bachelor of Science in Development Communication",
  period: "2021 — 2025",
  honors: "Magna Cum Laude Awardee",
};

const accomplishments = [
  {
    year: "2025",
    text: "Civil Service Examination — Professional Level Passer",
  },
  {
    year: "2024",
    text: "Delegate, Online International Exchange Program (Code AH23) with ECC Kokusai College of Foreign Languages, Japan",
  },
];
---

<section class="about section tex-diagonal" id="about" aria-labelledby="about-title">
  <div class="shell about__grid">
    <figure class="about__figure reveal reveal--left">
      <div
        class="ph ph--tall"
        data-caption="Portrait — placeholder"
        data-parallax="0.5"
        role="img"
        aria-label="Portrait placeholder"
      >
      </div>
      <figcaption class="about__caption label">Camarines Sur · Open to opportunities</figcaption>
    </figure>

    <div class="about__body stack-md reveal reveal--right" style="--reveal-delay: 0.12s">
      <span class="label">About Hairly</span>
      <h2 class="section-title" id="about-title" data-split>
        Organized, proactive, and intentional.
      </h2>

      <p class="body-text">
        An organized and dependable Development Communication graduate with
        experience in administrative support, legal transcription, and community
        outreach. Skilled in content creation, digital communication, team
        coordination, and workflow management, with a proven ability to deliver
        accurate, engaging, and culturally relevant materials. Organized,
        proactive, and committed to creating meaningful digital experiences.
      </p>

      <div class="about__detail">
        <span class="label">Education</span>
        <p class="about__school">{education.school}</p>
        <p class="about__meta">
          {education.location} · {education.degree}
        </p>
        <p class="about__meta">
          {education.period} · <strong>{education.honors}</strong>
        </p>
      </div>

      <div class="about__detail">
        <span class="label">Accomplishments</span>
        <ul class="about__list">
          {
            accomplishments.map((item) => (
              <li>
                <span class="about__year">{item.year}</span>
                <span>{item.text}</span>
              </li>
            ))
          }
        </ul>
      </div>

      <a class="link-arrow" href="#contact">
        More About Me <span aria-hidden="true">→</span>
      </a>
    </div>
  </div>
</section>

<style>
  .about__grid {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: clamp(2rem, 6vw, 5rem);
    align-items: start;
  }

  .about__figure {
    margin: 0;
    position: sticky;
    top: calc(var(--nav-h) + 1.5rem);
  }

  .about__caption {
    margin-top: 1rem;
  }

  .about__body .section-title {
    max-width: 14ch;
  }

  .about__detail {
    padding-top: 1.25rem;
    border-top: 1px solid var(--line);
  }

  .about__detail .label {
    margin-bottom: 0.75rem;
  }

  .about__school {
    font-family: var(--font-display);
    font-size: clamp(1.25rem, 2.5vw, 1.6rem);
    line-height: 1.25;
  }

  .about__meta {
    color: var(--ink-soft);
    font-size: 0.95rem;
    margin-top: 0.3rem;
  }

  .about__meta strong {
    font-weight: 500;
    color: var(--accent);
  }

  .about__list li {
    display: grid;
    grid-template-columns: 3.5rem 1fr;
    gap: 1rem;
    padding-block: 0.85rem;
    border-bottom: 1px solid var(--line);
    color: var(--ink-soft);
    font-size: 0.98rem;
  }

  .about__list li:last-child {
    border-bottom: 0;
  }

  .about__year {
    font-family: var(--font-display);
    font-size: 1.15rem;
    color: var(--ink);
  }

  @media (max-width: 860px) {
    .about__grid {
      grid-template-columns: 1fr;
    }

    .about__figure {
      position: static;
      max-width: 26rem;
    }
  }
</style>
