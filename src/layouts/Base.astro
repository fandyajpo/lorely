---
import "../styles/global.css";
import "@fontsource/instrument-serif/latin-400.css";
import "@fontsource/instrument-serif/latin-400-italic.css";
import "@fontsource-variable/inter/wght.css";
import instrumentRoman from "@fontsource/instrument-serif/files/instrument-serif-latin-400-normal.woff2?url";
import interLatin from "@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url";
import Nav from "../components/Nav.astro";
import LittleGhost from "../components/LittleGhost.astro";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Hairly Baylen — PR & Artist Communications",
  description = "Portfolio of Hairly Baylen — Development Communication graduate working in PR, artist communications, media relations, and creative strategy.",
} = Astro.props;

const chapters = [
  { id: "intro", label: "Intro" },
  { id: "about", label: "About" },
  { id: "experience", label: "Experience" },
  { id: "skills", label: "Skills" },
  { id: "direction", label: "Direction" },
  { id: "queue", label: "Queue" },
  { id: "media", label: "Media" },
  { id: "newsroom", label: "Newsroom" },
  { id: "campaign", label: "Campaign" },
  { id: "events", label: "Events" },
  { id: "crisis", label: "Crisis" },
  { id: "practice", label: "Practice" },
  { id: "contact", label: "Contact" },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <title>{title}</title>
    <meta name="theme-color" content="#f7f5f0" />
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      href={instrumentRoman}
      crossorigin
    />
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      href={interLatin}
      crossorigin
    />
    <script is:inline>
      // Enable cinematic scroll only when JS runs and motion is allowed.
      if (!window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
        document.documentElement.classList.add("has-js");
      }
    </script>
  </head>
  <body>
    <div class="curtain" aria-hidden="true">
      <div class="curtain__card">
        <span class="curtain__label">PR &amp; Artist Communications</span>
        <div class="curtain__name">
          <span class="curtain__word"><span>Hairly</span></span>
          <span class="curtain__word"><span>Baylen</span></span>
        </div>
        <div class="curtain__line"></div>
      </div>
      <span class="curtain__count">00</span>
    </div>

    <div class="scroll-progress" aria-hidden="true">
      <div class="scroll-progress__bar"></div>
    </div>

    <Nav />

    <nav class="rail" aria-label="Chapters">
      <ol>
        {
          chapters.map((chapter, i) => (
            <li>
              <a href={`#${chapter.id}`}>
                <span class="rail__label">{chapter.label}</span>
                <span class="rail__num">
                  {String(i + 1).padStart(2, "0")}
                </span>
              </a>
            </li>
          ))
        }
      </ol>
    </nav>

    <main id="top">
      <slot />
    </main>

    <LittleGhost />

    <script>
      const clamp = (v: number, min = 0, max = 1) =>
        Math.min(max, Math.max(min, v));

      if (document.documentElement.classList.contains("has-js")) {
        let resumeScroll: (() => void) | null = null;
        try {
        const [
          { animate, inView, stagger },
          { default: Lenis },
        ] = await Promise.all([import("motion"), import("lenis")]);

        /* ---------- smooth scroll ---------- */
        const lenis = new Lenis();
        resumeScroll = () => lenis.start();

        /* ---------- opening curtain ---------- */
        const runCurtain = async (): Promise<number> => {
          const curtain = document.querySelector<HTMLElement>(".curtain");
          if (!curtain) return 0;

          // Play once per session — repeat visits pay zero cost.
          try {
            if (sessionStorage.getItem("hairly-intro") === "1") {
              curtain.remove();
              return 0;
            }
            sessionStorage.setItem("hairly-intro", "1");
          } catch {
            /* storage unavailable — just play it */
          }

          lenis.stop();
          document.documentElement.style.overflow = "hidden";

          const ease = [0.22, 1, 0.36, 1] as [
            number,
            number,
            number,
            number,
          ];

          animate(
            ".curtain__label",
            { opacity: [0, 1], y: [10, 0] },
            { duration: 0.5, ease, delay: 0.1 },
          );
          animate(
            ".curtain__word > span",
            { y: ["120%", "0%"] },
            {
              duration: 0.9,
              ease,
              delay: stagger(0.12, { startDelay: 0.35 }),
            },
          );
          animate(
            ".curtain__line",
            { scaleX: [0, 1] },
            {
              duration: 0.85,
              ease: [0.65, 0, 0.35, 1] as [
                number,
                number,
                number,
                number,
              ],
              delay: 0.55,
            },
          );
          animate(
            ".curtain__count",
            { opacity: [0, 1] },
            { duration: 0.4, ease, delay: 0.15 },
          );

          // Counter 0 → 100 (plain rAF — cheaper than a tween library here)
          const countEl = curtain.querySelector<HTMLElement>(
            ".curtain__count",
          );
          const countDuration = 1150;
          const countStart = performance.now();
          await new Promise<void>((resolve) => {
            const step = (now: number) => {
              const p = Math.min(1, (now - countStart) / countDuration);
              const eased = 1 - Math.pow(1 - p, 3);
              if (countEl) {
                countEl.textContent = String(
                  Math.round(eased * 100),
                ).padStart(2, "0");
              }
              if (p < 1) requestAnimationFrame(step);
              else resolve();
            };
            requestAnimationFrame(step);
          });

          await new Promise((r) => setTimeout(r, 180));

          // Unlock scroll while the curtain still covers the page,
          // so the scrollbar restore is invisible.
          document.documentElement.style.overflow = "";
          lenis.start();

          await new Promise<void>((resolve) => {
            animate(
              curtain,
              { y: ["0%", "-100%"] },
              {
                duration: 0.8,
                ease: [0.76, 0, 0.24, 1] as [
                  number,
                  number,
                  number,
                  number,
                ],
                onComplete: () => resolve(),
              },
            );
          });

          curtain.remove();
          return 1400;
        };

        const introMs = await runCurtain();
        const introDelay = introMs / 1000;

        /* ---------- entrance + reveals (Motion) ---------- */
        animate(
          ".nav",
          { opacity: [0, 1], y: [-12, 0] },
          {
            duration: 0.6,
            ease: [0.22, 1, 0.36, 1],
            delay: introDelay + 0.05,
          },
        );

        const heroItems = document.querySelectorAll<HTMLElement>(
          ".hero__inner > *",
        );
        if (heroItems.length) {
          animate(
            heroItems,
            { opacity: [0, 1], y: [28, 0] },
            {
              delay: stagger(0.14, {
                startDelay: introDelay + 0.15,
              }),
              duration: 0.9,
              ease: [0.22, 1, 0.36, 1],
            },
          );
        }

        inView(
          ".reveal",
          (target) => {
            const el = target as HTMLElement;
            if (el.classList.contains("is-visible")) return;
            el.classList.add("is-visible");

            const delay =
              parseFloat(
                getComputedStyle(el).getPropertyValue("--reveal-delay"),
              ) || 0;

            let from: Record<string, number[]> = {};
            if (el.classList.contains("reveal--left")) from = { x: [-28, 0] };
            else if (el.classList.contains("reveal--right"))
              from = { x: [28, 0] };
            else if (!el.classList.contains("reveal--fade"))
              from = { y: [24, 0] };

            animate(
              el,
              { opacity: [0, 1], ...from },
              {
                duration: 0.8,
                ease: [0.22, 1, 0.36, 1],
                delay,
              },
            );
          },
          { amount: 0.12 },
        );

        /* ---------- masked word reveals ---------- */
        document.querySelectorAll<HTMLElement>("[data-split]").forEach((el) => {
          if (el.children.length) {
            el.classList.add("is-split");
            return;
          }
          const words = (el.textContent || "").trim().split(/\s+/);
          el.textContent = "";
          const frag = document.createDocumentFragment();
          words.forEach((word, i) => {
            const mask = document.createElement("span");
            mask.className = "rw";
            const inner = document.createElement("span");
            inner.className = "rw__w";
            inner.style.setProperty("--i", String(i));
            inner.textContent = word;
            mask.appendChild(inner);
            frag.appendChild(mask);
            if (i < words.length - 1) {
              frag.appendChild(document.createTextNode(" "));
            }
          });
          el.appendChild(frag);
          el.classList.add("is-split");
          el.getBoundingClientRect(); /* force starting style */
          inView(
            el,
            () => {
              el.classList.add("is-in");
            },
            { amount: 0.35 },
          );
        });

        /* ---------- count-up stats ---------- */
        document
          .querySelectorAll<HTMLElement>("[data-countup]")
          .forEach((el) => {
            const target = parseInt(el.dataset.countup || "", 10);
            if (Number.isNaN(target)) return;
            const pad = el.dataset.pad === "true";
            const fmt = (v: number) =>
              pad ? String(v).padStart(2, "0") : String(v);
            inView(
              el,
              () => {
                if (el.dataset.done === "true") return;
                el.dataset.done = "true";
                const dur = 900;
                const start = performance.now();
                const tick = (now: number) => {
                  const t = Math.min((now - start) / dur, 1);
                  const eased = 1 - Math.pow(1 - t, 3);
                  el.textContent = fmt(Math.round(eased * target));
                  if (t < 1) requestAnimationFrame(tick);
                };
                el.textContent = fmt(0);
                requestAnimationFrame(tick);
              },
              { amount: 0.6 },
            );
          });

        /* ---------- marquee: pause off-screen ---------- */
        document.querySelectorAll<HTMLElement>("[data-marquee]").forEach((m) => {
          const io = new IntersectionObserver(([entry]) =>
            m.classList.toggle("is-running", entry.isIntersecting),
          );
          io.observe(m);
        });

        /* ---------- magnetic buttons (fine pointers only) ---------- */
        if (matchMedia("(pointer: fine)").matches) {
          document.querySelectorAll<HTMLElement>(".btn").forEach((btn) => {
            btn.addEventListener("pointermove", (e) => {
              const r = btn.getBoundingClientRect();
              const x = ((e.clientX - r.left) / r.width - 0.5) * 14;
              const y = ((e.clientY - r.top) / r.height - 0.5) * 10;
              btn.style.translate = `${x.toFixed(1)}px ${y.toFixed(1)}px`;
            });
            btn.addEventListener("pointerleave", () => {
              btn.style.translate = "0px 0px";
            });
          });
        }

        /* ---------- scene refs ---------- */
        const progressBar = document.querySelector<HTMLElement>(
          ".scroll-progress__bar",
        );
        const hero = document.querySelector<HTMLElement>(".hero");
        const queue = document.getElementById("queue");
        const queueTrack = document.querySelector<HTMLElement>(".queue__track");
        const parallaxEls =
          document.querySelectorAll<HTMLElement>("[data-parallax]");
        const funnelItems =
          document.querySelectorAll<HTMLElement>(".funnel__item");
        const funnel = document.querySelector<HTMLElement>(".funnel");
        const chainWords =
          document.querySelectorAll<HTMLElement>(".chain-word");
        const chain = document.querySelector<HTMLElement>(".recovery-chain");
        const railLinks = Array.from(
          document.querySelectorAll<HTMLAnchorElement>('.rail a[href^="#"]'),
        );
        const chapters = railLinks
          .map((a) => ({
            a,
            el: document.getElementById(
              a.getAttribute("href")!.slice(1),
            ),
          }))
          .filter((c): c is { a: HTMLAnchorElement; el: HTMLElement } =>
            Boolean(c.el),
          );

        /* ---------- queue reel sizing ---------- */
        const sizeQueue = () => {
          if (!queue || !queueTrack) return;
          const max = Math.max(
            0,
            queueTrack.scrollWidth - window.innerWidth,
          );
          queue.style.minHeight = `${window.innerHeight + max * 1.2}px`;
        };

        /* ---------- per-frame scene updates ---------- */
        const updateProgress = () => {
          if (!progressBar) return;
          const max =
            document.documentElement.scrollHeight - window.innerHeight;
          const p = max > 0 ? window.scrollY / max : 0;
          progressBar.style.transform = `scaleX(${clamp(p)})`;
        };

        const updateHero = () => {
          if (!hero) return;
          const start = hero.offsetTop;
          const span = Math.max(1, hero.offsetHeight * 0.55);
          const p = clamp((window.scrollY - start) / span);
          hero.style.setProperty("--hp", p.toFixed(3));
        };

        const updateQueue = () => {
          if (!queue || !queueTrack) return;
          const scrollable = queue.offsetHeight - window.innerHeight;
          if (scrollable <= 0) return;
          const p = clamp((window.scrollY - queue.offsetTop) / scrollable);
          const max = Math.max(
            0,
            queueTrack.scrollWidth - window.innerWidth,
          );
          queueTrack.style.transform = `translate3d(${(-p * max).toFixed(1)}px, 0, 0)`;
        };

        const updateParallax = () => {
          const vh = window.innerHeight;
          for (const el of parallaxEls) {
            const rect = el.getBoundingClientRect();
            if (rect.bottom < -120 || rect.top > vh + 120) continue;
            const speed = parseFloat(el.dataset.parallax || "0.4");
            const off =
              (rect.top + rect.height / 2 - vh / 2) / vh;
            el.style.transform = `translate3d(0, ${(-off * speed * 130).toFixed(1)}px, 0)`;
          }
        };

        const litSequence = (
          container: HTMLElement | null,
          selector: string,
        ) => {
          if (!container) return;
          const vh = window.innerHeight;
          const rect = container.getBoundingClientRect();
          const p = clamp((vh * 0.88 - rect.top) / (vh * 0.55));
          const items = container.querySelectorAll<HTMLElement>(selector);
          items.forEach((item, i) => {
            item.classList.toggle(
              "is-lit",
              p >= (i + 1) / (items.length + 0.4),
            );
          });
        };

        const updateRail = () => {
          if (!chapters.length) return;
          const mark = window.innerHeight * 0.35;
          let active = chapters[0];
          for (const chapter of chapters) {
            if (chapter.el.getBoundingClientRect().top <= mark) {
              active = chapter;
            }
          }
          for (const chapter of chapters) {
            chapter.a.classList.toggle("is-active", chapter === active);
          }
        };

        const updateAll = () => {
          updateProgress();
          updateHero();
          updateQueue();
          updateParallax();
          litSequence(funnel, ".funnel__item");
          litSequence(chain, ".chain-word");
          updateRail();
        };

        /* ---------- anchors through Lenis ---------- */
        document.addEventListener("click", (event) => {
          const link = (event.target as HTMLElement).closest?.(
            'a[href^="#"]',
          ) as HTMLAnchorElement | null;
          if (!link) return;
          const hash = link.getAttribute("href");
          if (!hash || hash === "#") return;
          const target = document.getElementById(hash.slice(1));
          if (!target) return;
          event.preventDefault();
          lenis.scrollTo(target, { offset: -68, duration: 1.4 });
        });

        /* ---------- master loop (idle-gated: only update on scroll) ---------- */
        sizeQueue();
        updateAll();

        let dirty = true;
        const markDirty = () => {
          dirty = true;
        };

        lenis.on("scroll", markDirty);
        window.addEventListener("scroll", markDirty, { passive: true });

        document.fonts?.ready.then(() => {
          sizeQueue();
          dirty = true;
        });

        let resizeTimer: ReturnType<typeof setTimeout> | undefined;
        window.addEventListener("resize", () => {
          clearTimeout(resizeTimer);
          resizeTimer = setTimeout(() => {
            sizeQueue();
            updateAll();
          }, 120);
        });

        const frame = (time: number) => {
          lenis.raf(time);
          if (dirty) {
            dirty = false;
            updateAll();
          }
          requestAnimationFrame(frame);
        };
        requestAnimationFrame(frame);
        } catch (err) {
          // Fail open: never leave content hidden or scroll locked.
          console.error("[scroll-engine]", err);
          document.documentElement.style.overflow = "";
          document.querySelector(".curtain")?.remove();
          resumeScroll?.();
          document.documentElement.classList.remove("has-js");
        }
      }
    </script>
  </body>
</html>
